# Local Suricata detection rules for NHMF lab environment
# These supplement the Emerging Threats Open ruleset

# -----------------------------------------------------------------
# Port Scan Detection
# -----------------------------------------------------------------
alert tcp any any -> $HOME_NET any (msg:"NHMF SCAN TCP SYN port scan detected"; flags:S; threshold: type threshold, track by_src, count 20, seconds 10; sid:9000001; rev:1; classtype:attempted-recon;)
alert udp any any -> $HOME_NET any (msg:"NHMF SCAN UDP port scan detected"; threshold: type threshold, track by_src, count 30, seconds 10; sid:9000002; rev:1; classtype:attempted-recon;)

# -----------------------------------------------------------------
# ICMP Flood Detection
# -----------------------------------------------------------------
alert icmp any any -> $HOME_NET any (msg:"NHMF DOS ICMP flood detected"; itype:8; threshold: type threshold, track by_src, count 100, seconds 5; sid:9000003; rev:1; classtype:bad-unknown;)

# -----------------------------------------------------------------
# DNS Tunneling Heuristic (large TXT / NULL query)
# -----------------------------------------------------------------
alert dns any any -> any 53 (msg:"NHMF DNS possible tunneling - long query"; dns.query; content:"|00 10|"; offset:2; depth:2; threshold: type threshold, track by_src, count 5, seconds 60; sid:9000004; rev:1; classtype:policy-violation;)

# -----------------------------------------------------------------
# SSH Brute Force Detection
# -----------------------------------------------------------------
alert tcp any any -> $HOME_NET 22 (msg:"NHMF BRUTE SSH brute force attempt"; flow:to_server,established; threshold: type threshold, track by_src, count 5, seconds 30; sid:9000005; rev:1; classtype:attempted-admin;)

# -----------------------------------------------------------------
# Suspicious Outbound Traffic (common C2 ports)
# -----------------------------------------------------------------
alert tcp $HOME_NET any -> any 4444 (msg:"NHMF C2 suspicious outbound port 4444 (Metasploit default)"; flow:to_server,established; sid:9000006; rev:1; classtype:trojan-activity;)
alert tcp $HOME_NET any -> any 1337 (msg:"NHMF C2 suspicious outbound port 1337"; flow:to_server,established; sid:9000007; rev:1; classtype:trojan-activity;)

# -----------------------------------------------------------------
# HTTP Basic Auth over cleartext
# -----------------------------------------------------------------
alert http any any -> any any (msg:"NHMF POLICY HTTP Basic Auth credentials in cleartext"; http.header; content:"Authorization: Basic"; nocase; sid:9000008; rev:1; classtype:policy-violation;)

# -----------------------------------------------------------------
# Large DNS Response (possible data exfil)
# -----------------------------------------------------------------
alert dns any 53 -> any any (msg:"NHMF DNS anomalously large response"; dsize:>512; threshold: type threshold, track by_src, count 3, seconds 60; sid:9000009; rev:1; classtype:policy-violation;)

# -----------------------------------------------------------------
# FTP Login Attempt
# -----------------------------------------------------------------
alert tcp any any -> $HOME_NET 21 (msg:"NHMF FTP login attempt detected"; flow:to_server,established; content:"USER "; nocase; sid:9000010; rev:1; classtype:attempted-admin;)
