COMPOSE_PROJECT_NAME=nhmf
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123
# Optional. Requires internet from inside the Grafana container.
# GRAFANA_INSTALL_PLUGINS=alexanderzobnin-zabbix-app
ZABBIX_DB_NAME=zabbix
ZABBIX_DB_USER=zabbix
ZABBIX_DB_PASSWORD=zabbix
ZABBIX_DB_ROOT_PASSWORD=zabbix-root
ZABBIX_ADMIN_USER=Admin
ZABBIX_ADMIN_PASSWORD=zabbix
ZABBIX_REFRESH_SECONDS=15
# Deterministic private network used by native Zabbix checks. If 172.30.0.0/24
# overlaps another Docker/VPN network, change every value in this block together.
NHMF_ZABBIX_SUBNET=172.30.0.0/24
NHMF_ZABBIX_DYNAMIC_RANGE=172.30.0.128/25
ZABBIX_PASSIVE_ALLOWED=172.30.0.0/24
ZABBIX_DB_STATIC_IP=172.30.0.10
ZABBIX_SERVER_STATIC_IP=172.30.0.11
ZABBIX_WEB_STATIC_IP=172.30.0.12
ZABBIX_AGENT_CORE_IP=172.30.0.20
ZABBIX_AGENT_APPLICATION_IP=172.30.0.21
ZABBIX_AGENT_DATABASE_IP=172.30.0.22
ZABBIX_AGENT_SECURITY_IP=172.30.0.23
ZABBIX_AGENT_WEB_IP=172.30.0.24
ZABBIX_AGENT_API_IP=172.30.0.25
ZABBIX_AGENT_BACKUP_IP=172.30.0.26
# Suricata — set to your Ubuntu host's primary network interface
# Typical values: eth0, ens3, ens33, ens160, enp0s3
# Auto-detect with: ip route get 8.8.8.8 | awk '{print $5; exit}'
SURICATA_INTERFACE=eth0
